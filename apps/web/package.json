    "@tract/domain": "workspace:*",
    "@tract/integrations": "workspace:*",
    "@tract/mortgage-math": "workspace:*",
    "@tract/schemas": "workspace:*",
    "@tract/seo": "workspace:*",
    "@tract/tokens": "workspace:*",
    "@tract/vision-model": "workspace:*",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.16",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.5",
    "wrangler": "^4.160.0"
