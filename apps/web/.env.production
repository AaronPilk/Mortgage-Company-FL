# Build-time public configuration.
#
# Committed deliberately. Every value here is a NEXT_PUBLIC_* value, which Next
# compiles into the browser bundle — so none of it is secret, and committing it
# means a Git-connected build needs no dashboard variables at all.
#
# A secret must NEVER be added to this file. scripts/check-site-url.mjs fails the
# build if it finds a key here that is not NEXT_PUBLIC_-prefixed. Secrets go to
# `wrangler secret put` or the Worker's encrypted settings.
NEXT_PUBLIC_SITE_URL=https://mortgage-company-fl.aaron-9c3.workers.dev
NEXT_PUBLIC_BRAND_NAME=TRACT Mortgage

# Supabase browser configuration. The anon key is designed to ship in the
# browser; Row Level Security is what protects the data behind it.
NEXT_PUBLIC_SUPABASE_URL=https://pywikpvjovaayidxyoii.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InB5d2lrcHZqb3ZhYXlpZHh5b2lpIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODY5OTc0MzksImV4cCI6MjEwMjU3MzQzOX0.bha_lnIIsEQyr_0Ljl6cMvOJjboaGN4FHab2e6vPPco

# Turnstile browser widget. The site key is public by design — it renders in
# the page markup for every visitor. Its secret counterpart lives only in the
# Worker's encrypted settings as TURNSTILE_SECRET_KEY.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAEULP2terrAiwi0j
