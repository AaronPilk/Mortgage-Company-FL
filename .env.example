# TRACT Mortgage — environment reference.
#
# Copy to .env.local for development. NEVER put a real secret in this file; it is
# tracked in git. Every variable below is annotated with where it may be read:
#
#   [browser-safe] compiled into the client bundle. Identifiers only, never secrets.
#   [server-only]  read only in server code. A value here must never gain a
#                  NEXT_PUBLIC_ prefix.
#
# The application boots and passes its whole test suite with this file as-is,
# every integration disabled and no secret present. That is deliberate: a
# developer should never need a production credential to run the site.

# ---------------------------------------------------------------- #
# Brand and site
# ---------------------------------------------------------------- #
# [browser-safe] Also read at BUILD time — robots.txt and sitemap.xml are
# generated statically, so this must be set in the build environment, not only
# at runtime.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# [browser-safe]
NEXT_PUBLIC_BRAND_NAME=TRACT Mortgage

# ---------------------------------------------------------------- #
# Analytics — consent-gated, never loaded before a choice is made
# ---------------------------------------------------------------- #
# [browser-safe] Google Tag Manager container, e.g. GTM-XXXXXXX
NEXT_PUBLIC_GTM_CONTAINER_ID=

# ---------------------------------------------------------------- #
# Supabase
# ---------------------------------------------------------------- #
# [browser-safe]
NEXT_PUBLIC_SUPABASE_URL=
# [browser-safe] The anon key is designed to be public; Row Level Security is
# what protects the data, which is why every table has policies and tests.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# [server-only] Bypasses Row Level Security. Used only by narrow, audited server
# functions. If this ever appears in a client bundle, rotate it immediately.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------- #
# Cloudflare Turnstile — bot challenge on conversion forms
# ---------------------------------------------------------------- #
# [browser-safe]
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# [server-only] disabled | fixture | sandbox | production
TURNSTILE_MODE=disabled
# [server-only] Required once mode is sandbox or production.
TURNSTILE_SECRET_KEY=

# ---------------------------------------------------------------- #
# GoHighLevel — marketing CRM only
# ---------------------------------------------------------------- #
# Never the system of record for an application or a loan file. See
# docs/integrations/ghl.md for the field boundary that is enforced in code.
# [server-only] disabled | fixture | sandbox | production
GHL_MODE=disabled
# [server-only]
GHL_PRIVATE_INTEGRATION_TOKEN=
# [server-only]
GHL_LOCATION_ID=
# [server-only]
GHL_API_BASE_URL=https://services.leadconnectorhq.com
# [server-only]
GHL_API_VERSION=2021-07-28
# [server-only] PEM-encoded Ed25519 public key used to verify inbound webhooks.
GHL_WEBHOOK_PUBLIC_KEY=
# [server-only] JSON map of internal semantic key -> provider custom field id.
# Configuration rather than code, so a CRM rebuild is a variable change.
GHL_CUSTOM_FIELD_MAP={}
# [server-only] JSON map of pipeline key -> { pipelineId, stages }.
GHL_PIPELINE_MAP={}

# ---------------------------------------------------------------- #
# AI providers
# ---------------------------------------------------------------- #
# [server-only] disabled | fixture | sandbox | production
AI_MODE=disabled
# [server-only]
OPENAI_API_KEY=
# [server-only]
ANTHROPIC_API_KEY=
# [server-only]
HIGGSFIELD_API_KEY=
# [server-only]
BYTEPLUS_API_KEY=
# [server-only] Hard daily ceiling across all users and features, in cents.
AI_DAILY_PLATFORM_BUDGET_CENTS=0
# [server-only] Default per-user daily ceiling, in cents.
AI_DEFAULT_USER_DAILY_BUDGET_CENTS=0

# ---------------------------------------------------------------- #
# Listing data
# ---------------------------------------------------------------- #
# [server-only] disabled | fixture | stellar | bridge | mlsgrid
# "fixture" is development only. Publishing fixture records is blocked by a
# database constraint as well as by application configuration.
MLS_PROVIDER=fixture
# Second switch. Sample listings render publicly only when BOTH are set, so a
# forgotten default cannot publish invented properties on its own. Safe to turn
# on only while every sample record is labelled in the UI, the routes stay
# noindex, and no listing JSON-LD is emitted. See docs/handoff/DECISIONS.md.
SHOW_SAMPLE_LISTINGS=false
# [server-only]
MLS_BASE_URL=
# [server-only]
MLS_ACCESS_TOKEN=
# [server-only] Attribution text required by the display agreement.
MLS_ATTRIBUTION_TEXT=

# ---------------------------------------------------------------- #
# Property data providers — all contract-gated
# ---------------------------------------------------------------- #
# [server-only]
ATTOM_API_KEY=
# [server-only]
REGRID_API_KEY=
# [server-only]
SHOVELS_API_KEY=
# [server-only]
AIRDNA_API_KEY=

# ---------------------------------------------------------------- #
# Feature flags
# ---------------------------------------------------------------- #
# [server-only] The browser receives derived booleans only, never these values.
FEATURE_VISION=false
FEATURE_RENDPROP=false
FEATURE_ACCOUNTS=true
FEATURE_PROPERTY_SEARCH=false

# ---------------------------------------------------------------- #
# Observability and email
# ---------------------------------------------------------------- #
# [server-only]
SENTRY_DSN=
# [server-only] disabled | fixture | sandbox | production
EMAIL_MODE=disabled
# [server-only]
RESEND_API_KEY=

# ---------------------------------------------------------------- #
# Approved external handoff
# ---------------------------------------------------------------- #
# [server-only] The secure POS/LOS application URL. While unset, /apply tells the
# visitor that applications are not open rather than collecting anything.
SECURE_APPLICATION_URL=

# ---------------------------------------------------------------- #
# Cryptographic material
# ---------------------------------------------------------------- #
# [server-only] Salt for one-way hashes used in deduplication and abuse signals.
# Must be replaced before serving real traffic; the deploy preflight refuses the
# development default. Rotating it resets dedupe and rate-limit buckets.
HASH_PEPPER=local-development-pepper-change-me
